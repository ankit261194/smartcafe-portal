{
  "manifest_version": 3,
  "name": "Smart Cafe Master Bot (e-District & Rekha Print Auto-Relay)",
  "version": "1.1.0",
  "description": "Silent e-District 1-Click Auto-Filler and 100% Automated Rekha Print B2B Order Dispatch & PDF Fetcher Bot.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "*://edistrict.up.gov.in/*",
    "https://smartcafe.sbs/*",
    "http://localhost:5000/*",
    "*://rekhaprint.info/*",
    "*://rekhaprint.co/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://edistrict.up.gov.in/*"
      ],
      "js": [
        "content_script.js"
      ],
      "css": [
        "content_style.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Smart Cafe e-District Helper"
  }
}
